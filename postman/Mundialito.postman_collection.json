{
  "info": {
    "_postman_id": "ef3f9e52-e514-4e72-aa56-acdeab289b55",
    "name": "Mundialito API",
    "description": "Pruebas funcionales para todos los endpoints de Mundialito. Ejecutar la colección completa en orden con el entorno Mundialito - Local Docker. La carpeta 00 inicializa las variables dinámicas y lee los identificadores del seed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Preparación",
      "description": "Comprueba la API, genera claves únicas y carga identificadores del seed.",
      "item": [
        {
          "name": "Health e inicializar variables",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = `${Date.now()}-${Math.floor(Math.random() * 100000)}`;",
                  "pm.environment.set('runId', runId);",
                  "const keyVariables = [",
                  "  'teamCrudKey', 'playerCrudKey', 'matchCrudKey', 'goalCrudKey',",
                  "  'idempotencyCaseKey', 'errorValidationKey', 'errorConflictKey',",
                  "  'errorPlayerKey', 'errorMatchKey', 'errorGoalKey'",
                  "];",
                  "keyVariables.forEach(name => pm.environment.set(name, pm.variables.replaceIn('{{$guid}}')));",
                  "const idVariables = [",
                  "  'liverpoolTeamId', 'barcelonaTeamId', 'liverpoolPlayerId',",
                  "  'scheduledMatchId', 'createdTeamId', 'createdPlayerId',",
                  "  'createdMatchId', 'createdGoalId', 'idempotencyTeamId'",
                  "];",
                  "idVariables.forEach(name => pm.environment.unset(name));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La API responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('El servicio está saludable', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});",
                  "pm.test('El entorno contiene baseUrl', () => {",
                  "  pm.expect(pm.environment.get('baseUrl')).to.match(/^https?:\\/\\//);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Primera petición del runner. Regenera runId y todas las Idempotency-Key usadas por la colección."
          }
        },
        {
          "name": "Cargar equipos del seed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lista de equipos disponible', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const liverpool = body.data.find(team => team.name === 'Liverpool');",
                  "const barcelona = body.data.find(team => team.name === 'Barcelona');",
                  "pm.test('El seed contiene Liverpool y Barcelona', () => {",
                  "  pm.expect(liverpool, 'Liverpool no existe; usa una base vacía con el seed actual').to.exist;",
                  "  pm.expect(barcelona, 'Barcelona no existe; usa una base vacía con el seed actual').to.exist;",
                  "});",
                  "if (liverpool) pm.environment.set('liverpoolTeamId', liverpool.id);",
                  "if (barcelona) pm.environment.set('barcelonaTeamId', barcelona.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/teams?pageNumber=1&pageSize=100&sortBy=name&sortDirection=asc"
          }
        },
        {
          "name": "Cargar jugador de Liverpool",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Jugadores de Liverpool disponibles', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const player = body.data.find(item =>",
                  "  item.firstName === 'Miguel Alberto' && item.lastName === 'Rodriguez Barrientos');",
                  "pm.test('El seed contiene a Miguel Alberto Rodriguez Barrientos', () => {",
                  "  pm.expect(player, 'No se encontró el jugador esperado del seed').to.exist;",
                  "});",
                  "if (player) pm.environment.set('liverpoolPlayerId', player.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/players?pageNumber=1&pageSize=100&teamId={{liverpoolTeamId}}"
          }
        },
        {
          "name": "Cargar partido programado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Partidos programados disponibles', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const match = body.data[0];",
                  "pm.test('Existe un partido programado de Liverpool', () => {",
                  "  pm.expect(match, 'No se encontró un partido programado del seed').to.exist;",
                  "});",
                  "if (match) pm.environment.set('scheduledMatchId', match.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/matches?pageNumber=1&pageSize=100&teamId={{liverpoolTeamId}}&status=Scheduled"
          }
        }
      ]
    },
