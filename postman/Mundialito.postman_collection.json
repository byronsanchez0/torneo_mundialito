                  "    pm.expect([match.homeTeamId, match.awayTeamId]).to.include(teamId);",
                  "    pm.expect(match.status).to.eql('Scheduled');",
                  "    pm.expect(Date.parse(match.scheduledAtUtc)).to.be.within(Date.parse('2000-01-01T00:00:00Z'), Date.parse('2100-01-01T00:00:00Z'));",
                  "  });",
                  "});"
                ]
